# Copy this file to .env.local and fill in your own values

# Supabase — find these at: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# That's it — video upload uses Supabase Storage, no other service needed.
#
# Optional, for later: if you want Cloudflare Stream's automatic video
# transcoding (smaller file sizes for viewers on weak/expensive data), you
# can add that back in — ask Claude for help wiring it up when you're ready.
